<group name="local,">

  <!-- ... otras reglas locales existentes ... -->

  <rule id="100050" level="0">
    <if_sid>592</if_sid>
    <regex>/var/log/fortigate/.*\.log</regex>
    <description>Ignorar reduccion de tamano en cualquier log de Fortigate.</description>
  </rule>

</group>


<group name="fortigate,custom">

  <!-- FortiGate IPS Critical -->
  <rule id="100300" level="12">
    <if_sid>81629</if_sid>
    <field name="crlevel">^critical$</field>
    <description>
      FortiGate - IPS Critical $(msg)
    </description>
    <group>
      fortigate,attack,critical
    </group>
  </rule>

  <!-- FortiGate IPS High -->
  <rule id="100301" level="12">
    <if_sid>81629</if_sid>
    <field name="crlevel">^high$</field>
    <description>
      FortiGate - IPS High $(msg)
    </description>
    <group>
      fortigate,attack,high
    </group>
  </rule>

  <!-- FortiGate IPS Medium -->
  <rule id="100302" level="10">
    <if_sid>81629</if_sid>
    <field name="crlevel">^medium$</field>
    <description>
      FortiGate - IPS Medium $(msg)
    </description>
    <group>
      fortigate,attack,medium
    </group>
  </rule>

  <rule id="100303" level="12">
    <if_sid>81612</if_sid>
    <description>FortiGate - Cambio de configuracion realizado (Edit) by $(dstuser)</description>
    <group>fortigate,configuration_change,critical</group>
  </rule>

</group>
