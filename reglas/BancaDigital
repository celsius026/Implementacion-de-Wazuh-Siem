<rule id="110225" level="12" frequency="5" timeframe="180">
    <if_matched_sid>110210</if_matched_sid>
    <same_srcip/>
    <different_field>BDigitalUserName</different_field>
    <description>La direcion IP $(srcip) intento loguearse a mas de 5 usuarios en 3 minutos</description>
    <group>banca_credential_stuffing,attack,</group>
</rule>


 <rule id="110212" level="12" frequency="10" timeframe="300">
    <if_matched_sid>110210</if_matched_sid>
    <same_srcip/>
    <description>Posible fuerza bruta desde la IP $(srcip) - mas de 10 logins fallidos </description>
    <group>authentication_failures,brute_force,attack,</group>
 </rule>

 <rule id="177151" level="9">
    <if_sid>177150</if_sid>
    <field name="dark_severity">^0$|^1$|^2$</field>
