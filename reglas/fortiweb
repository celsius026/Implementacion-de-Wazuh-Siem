<!-- Modify it at your will. -->
<group name="fortiweb,syslog,">

  <!--
    Regla base FortiWeb: todo lo que decodifique el decoder 'fortiweb'
    entra a nivel 3 para que vaya a alerts y puedas empezar a perfilar la data.
  -->
  <rule id="100990" level="3">
    <decoded_as>fortiweb</decoded_as>
    <description>FortiWeb: evento WAF - $(http_method) $(http_url) desde $(srcip) hacia $(http_host)</description>
    <group>fortiweb,</group>
  </rule>

  <!-- Alerta nivel 13 para todo lo HIGH excepto fallos de firma de cookies -->
  <rule id="100992" level="13">
    <if_sid>100990</if_sid>
    <field name="severity_level">High</field>
    <!-- Negamos el subtipo ruidoso de cookies -->
    <field name="sub_type" negate="yes">Cookie Signed Verification Failed</field>
    <description>FortiWeb:$(msg)</description>
    <group>attack,syslog_high_severity,</group>
  </rule>

</group>
