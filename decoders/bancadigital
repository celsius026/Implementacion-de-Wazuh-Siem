<!--
  - Allowed static fields:
  - location   - where the log came from (only on FTS)
  - srcuser    - extracts the source username
  - dstuser    - extracts the destination (target) username
  - user       - an alias to dstuser (only one of the two can be used)
  - srcip      - source ip
  - dstip      - dst ip
  - srcport    - source port
  - dstport    - destination port
  - protocol   - protocol
  - id         - event id
  - url        - url of the event
  - action     - event action (deny, drop, accept, etc)
  - status     - event status (success, failure, etc)
  - extra_data - Any extra data
-->

<!-- ============ PADRE ============ -->
<decoder name="BancaDigital">
    <prematch>CortexAuditWorker </prematch>
</decoder>

<!-- ============ LOGIN ============ -->
<decoder name="BDigitalLogin">
    <parent>BancaDigital</parent>
    <use_own_name>true</use_own_name>
    <prematch>"service":"login"</prematch>
    <regex offset="after_parent" type="pcre2">^\{"email":"([^"]*)","requireWebOtp":"([^"]*)","mfaOtpHash":"([^"]*)","id":"([^"]*)","logType":"([^"]*)","sessionId":"([^"]*)","userName":"([^"]*)","userId":"([^"]*)","ip":"([^"]*)","service":"([^"]*)","channel":"([^"]*)","infoDevice":"([^"]*)","browserName":"([^"]*)","os":"([^"]*)","deviceVersion":"([^"]*)","geoLocalization":"([^"]*)"</regex>
